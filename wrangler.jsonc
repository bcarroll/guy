{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "guy",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "run_worker_first": ["/hf/*"]
  },
  // Pull request builds run `wrangler preview`, which stops unless this block exists. Empty: the Worker has no bindings or vars to swap for previews.
  "previews": {}
}
